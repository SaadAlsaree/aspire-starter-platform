{
  "Authentication": {
    "Keycloak": {
      "ServiceName": "keycloak",
      "Realm": "starter",
      "Audience": "simble-api",
      "RequireHttpsMetadata": true,
      "ClockSkew": "00:00:00",
      "ValidIssuers": []
    }
  },
  "OpenApi": {
    "DocumentName": "v1",
    "Title": "Simble API",
    "Description": "Starter service API",
    "ExposeInProduction": false,
    "OAuthClientId": "scalar",
    "Scopes": {
      "openid": "OpenID Connect"
    }
  },
  "Database": {
    "Migration": {
      "RunOnStartup": true
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Authenticated": {
      "TokenLimit": 60,
      "TokensPerPeriod": 10,
      "ReplenishmentPeriodSeconds": 10
    },
    "Anonymous": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
